    <!-- Experimental: Flyme-style Lightweight Freeform -->
    <string name="exp_flyme_freeform_title">Flyme 样式轻量小窗</string>
    <string name="exp_flyme_freeform_summary">直接打开为轻量小窗（即用即走），支持外部点击退出、小白条手势转换、窗口居中及禁止偏移</string>
    <string name="exp_section_window_tuning">窗口尺寸与位置</string>
    <string name="exp_center_window">小窗居中显示</string>
    <string name="exp_center_window_summary">修正 HyperOS 原版小窗偏上的问题，将小窗垂直居中置于屏幕中央</string>
    <string name="exp_no_offset">禁止小窗偏移</string>
    <string name="exp_no_offset_summary">已经有小窗时，新开的小窗仍然开在同一个默认位置。HyperOS 默认会给第二个小窗加一个避让偏移（右移 78dp、下移 44dp，看起来是往右下挪了一点），Flyme 则每次都开在同一处；关掉即恢复系统原样</string>
    <string name="exp_window_scale">小窗缩放比例</string>
    <string name="exp_window_scale_hint" formatted="false">对齐 Flyme 视觉，默认 80% 视觉宽度（HyperOS 原版约 67%）</string>
    <string name="exp_dim_background">背景暗化遮罩</string>
    <string name="exp_dim_background_summary">轻量小窗呼出时为背景添加暗色蒙版，突出当前窗口焦点</string>
    <string name="exp_section_gestures">小白条手势交互</string>
    <string name="exp_outside_dismiss">点击外部关闭小窗</string>
    <string name="exp_outside_dismiss_action">外部关闭手势</string>
    <string name="exp_outside_dismiss_action_single">单击</string>
    <string name="exp_outside_dismiss_action_double">双击</string>
    <string name="exp_outside_dismiss_summary">轻量小窗核心体验：点击或双击小窗外部任意区域直接退出</string>
    <string name="exp_swipe_up_mini">小白条上滑转为迷你小窗</string>
    <string name="exp_swipe_up_mini_summary">快速上滑小白条直接挂起为侧边迷你小窗，替换原版关闭逻辑</string>
    <string name="exp_swipe_up_hold_free">小白条上滑悬停转自由小窗</string>
    <string name="exp_swipe_up_hold_free_summary">向上拖动并停留悬停时退出接管，转为 HyperOS 原生常驻自由小窗</string>
    <string name="exp_swipe_down_fullscreen">小白条下滑全屏展开</string>
    <string name="exp_swipe_down_fullscreen_summary">向下快速滑动小白条直接全屏化当前应用</string>
    <string name="exp_section_info">说明</string>
    <string name="exp_freeform_info">开启后，小窗将以轻量小窗模式启动。通过小白条上滑悬停转为自由小窗后，模块将直接取消接管，恢复 HyperOS 原生小窗的所有操作（左右拉伸调大小、顶部三点菜单等）。</string>

    <!-- 小窗底部联系人条（Flyme「联系人头像」移植） -->
    <string name="exp_section_contact_bar">小窗联系人条</string>
    <string name="exp_contact_bar">显示最近联系人头像</string>
    <string name="exp_contact_bar_min_width">小窗宽度低于此值时隐藏</string>
    <string name="exp_contact_bar_min_width_off">不隐藏</string>
    <string name="exp_contact_bar_summary" formatted="false">微信 / QQ 等应用以小窗打开时，在小窗下方显示最近聊天的联系人（头像 + 名称）：宽度始终与小窗一致并随拉伸实时变化，圆角与小窗一致；小窗变为迷你小窗、或缩小到阈值以下时自动隐藏。点击头像直接在该小窗内打开会话，在头像上上下滑动可移除该联系人。头像与名称来自系统通知，不读取应用数据；因 HyperOS 打开应用会清空其通知，模块会把会话记忆 12 小时。上方阈值按「小窗宽度 ÷ 屏幕宽度」计算：默认 60%（约等于 ROM 默认小窗 70% 宽度的 85%），嫌太敏感就往下调，0 = 完全不按尺寸隐藏。</string>
</resources>
