<!-- EmptyHint cell: pinned-area cell host mirroring rl_selected_apps
     (minHeight 78dp — AppDragLayout keeps its height even while empty,
     app_settings_item_selected.xml:8; marginTop 12dp / marginBottom 20dp)
     and holding ONLY the click_add_tip hint (TipsSummary 14sp, marginTop 40dp,
     centered; visibility rule SlideLaunchAppSettings.java:1034 — this row exists
     exactly when the pinned list is empty; the ★ chips live in dedicated cells). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_selected_apps"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/fd_sys_margin_regular"
    android:layout_marginBottom="@dimen/fd_sys_margin_large"
    android:minHeight="78dp">

    <TextView
        android:textColor="@color/fd_sys_color_surface_container_highest_default"
        android:textSize="14sp"
        android:id="@+id/click_add_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/settings_tips_click_to_add_app"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
