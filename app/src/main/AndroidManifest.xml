<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      功能页（快捷方式）不需要 QUERY_ALL_PACKAGES：真正要「看见所有应用」的那次全量枚举
      （LauncherApps.getShortcuts + 逐个应用解析 shortcuts.xml）跑在 SystemUI 进程里，用的是
      SystemUI 自己的授权；App 进程这边只做两件事 —— queryIntentActivities(MAIN/LAUNCHER)
      与按包名取图标/标签，前者由下面这段 <queries> 兜住，后者针对的也是有启动图标的包。
      多要一个敏感权限只会让应用列表与出问题时更难解释，所以这里保持最小权限。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BubbleAppApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BubbleDrawer">

        <activity
            android:name=".settings.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screen.features.TriggerActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.GestureBlacklistActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.FanDockActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.MorePanelActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.LightOpenActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.LightOpenAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.FreeformActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.FreeformExtendActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.features.FreeformOtherActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.settings.ThemeActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.settings.DiagnosticsActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.about.LicenseActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <!-- 关于：设置页里的二级页（与 外观与主题 / 模块运行诊断 同级），不进底栏。 -->
        <activity
            android:name=".ui.screen.about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".ui.screen.about.CreditsActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar" />

        <activity
            android:name=".pin.PinManageActivity"
            android:exported="true"
            android:theme="@style/Theme.BubbleDrawer.NoActionBar"
            android:label="@string/slide_launch_app_settings_title" />

        <!-- Pin persistence handoff from the SystemUI overlay panel: the hook process
             cannot write the LSPosed remote group (read-only mirror there), so FanHost
             broadcasts the encoded order here and the app-side backend writes it (local
             mirror + remote group). Exported because SystemUI is another app; the receiver
             verifies the sender's identity and the payload grammar.

             (There used to be a startService() twin. It was removed: a service's
             onStartCommand runs in a plain Handler message, where Binder.getCallingUid()
             reports the process's OWN uid — so its caller check admitted everyone, i.e. any
             app could have posted pins="" and wiped both lists.) -->
        <receiver
            android:name=".xposed.PinSyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.repl.bubbledrawer.action.SYNC_PINS" />
            </intent-filter>
        </receiver>

        <!-- 气压重按校准：按压采样与阈值计算都在 SystemUI（那里才有气压计和扇形），结果经这条
             广播交回 App 落盘（hook 进程拿到的远程组是只读镜像，见上面的 SYNC_PINS）。接收者校验
             发送方，只认 SystemUI / system / 自己。 -->
        <receiver
            android:name=".xposed.PressureCalibrationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.repl.bubbledrawer.action.PRESSURE_CALIBRATION" />
            </intent-filter>
        </receiver>

        <!-- 校准事件的主通道：ContentResolver.call（同步 + 回执 + Binder.getCallingUid 判定身份），
             广播只作兜底。入口自己校验调用方 uid（system / 自己 / SystemUI 包）。 -->
        <provider
            android:name=".xposed.PressureCalibrationProvider"
            android:authorities="com.repl.bubbledrawer.calibration"
            android:exported="true"
            android:grantUriPermissions="false" />

        <provider
            android:name=".shortcut.ShortcutProvider"
            android:authorities="com.repl.bubbledrawer.shortcuts"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
